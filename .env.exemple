# Copier dans Vercel -> Settings -> Environment Variables.
# NE JAMAIS commiter les vraies valeurs.

SITE_URL=https://ardoise.vercel.app

# --- Supabase (PROJET ARDOISE, PAS CELUI DE CREATIS) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE=eyJ...        # serveur uniquement, jamais dans le navigateur

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Identifiants de prix Stripe (Produits -> Tarifs -> price_...) ---
PRIX_SERVICE=price_...              # 99 EUR / mois, recurrent
PRIX_MAISON=price_...               # 249 EUR / mois, recurrent
PRIX_GROUPE_BASE=price_...          # 249 EUR / mois, recurrent (socle)
PRIX_GROUPE_ETAB=price_...          # 45 EUR / mois, recurrent, quantite variable

# --- Rapport hebdomadaire (courrier du lundi) ---
BREVO_API_KEY=xkeysib-...           # Brevo -> SMTP & API -> API keys
EXPEDITEUR_EMAIL=rapport@ardoise.fr # adresse d'un domaine verifie chez Brevo
EXPEDITEUR_NOM=Ardoise
CRON_SECRET=                        # chaine longue et aleatoire : openssl rand -hex 32
                                    # Vercel l'envoie en Authorization sur la tache planifiee
SECRET_RAPPORT=                     # autre chaine aleatoire : signe les liens de desinscription
                                    # la changer invalide les liens des courriers deja partis

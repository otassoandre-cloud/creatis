# ===== CRÉATIS — .gitignore =====

# Variables d'environnement locales
.env
.env.local
.env.*.local
.env.*
!.env.example
.vercel

# Clés API et secrets — NE JAMAIS COMMITER
# js/config.js est committé SANS les vraies clés (elles sont dans Vercel)

# Dépendances
node_modules/
npm-debug.log*
yarn-debug.log*

# Bibliothèque de skills tierce (installée via marketplace, pas du code Créatis)
.agents/
skills-lock.json

# Build et cache
.cache/
dist/
build/
.next/
out/

# Système d'exploitation
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Éditeurs
.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Tests et rapports locaux (garder les fichiers HTML mais pas les assets générés)
tests/miniatures/*.jpg
tests/miniatures/*.png
tests/miniatures/*.webp

# Logs
*.log
logs/

# Divers
*.tmp
*.bak
*.orig

.vercel
.env*.local

# Backups locaux
_backup/

# Scratch local pour la génération de vidéos de démo (frames, brut, events.json)
.scratch-demo/

# Env Vercel (contient des vraies clés API — NE JAMAIS COMMITER)
.env.production
.env.development

# Raccourcis et fichiers Windows
*.lnk
*.url
*.zip
Desktop.ini
*.sh

# Dossiers non-projet (jeux, logiciels tiers)
D3D12/
MMO_Data/
MMO.exe
MonoBleedingEdge/
UnityCrashHandler64.exe
UnityPlayer.dll
MSI Afterburner/
Krita (x64)/
FULL BUREAU/
Vente Amazon Afilié/
topstep/

# Fichiers Claude (mémoire locale, ne pas partager)
.claude/

# Vidéos et fichiers lourds
drawing/
*.mp4
*.mov
*.avi

# EXCEPTION — les vidéos de démonstration du SITE doivent être déployées.
# La règle `*.mp4` ci-dessus les excluait sans distinction : elles n'ont donc jamais été
# commitées, jamais poussées, jamais servies par Vercel. Symptôme mesuré le 13/08/2026 :
# 8 showcase sur 8 en 404 sur la page d'accueil, 5 sur 5 dans le studio. Toutes les vignettes
# du site restaient figées sur leur poster, et sur iOS elles viraient au noir.
# Le `play()` de ces vidéos est enveloppé dans un `.catch(() => {})` : l'échec ne laissait
# aucune trace, ni dans la console, ni dans les logs.
# Poids réel de l'exception : ~5 Mo. Les 396 Mo de rushes (.scratch-*, drawing/, video/)
# restent exclus — c'est bien eux que cette règle devait viser.
!images/exemples/*.mp4
!images/loop/*.mp4

# Scripts de test locaux (contiennent des clés API)
tests/

# Config éditeur (personnel)
.cursor/

# Données et fichiers temporaires locaux
leads-*.csv
followed-creators.json
reddit-post-today.txt
preview-mini-*.png
preview-short-*.png
*.obj
*.mtl
supabase-prospects-table.sql

.env*.local

# Profil navigateur (session Instagram/TikTok connectée -- jamais commiter)
.playwright-profile-social/

.playwright-profile-submagic/
.scratch-submagic/

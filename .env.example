# ===== CRÉATIS — Variables d'environnement Vercel =====
# Copier dans : Vercel Dashboard > Project > Settings > Environment Variables
# NE PAS committer le .env avec de vraies valeurs

# ── IA ──────────────────────────────────────────────────
GROQ_API_KEY=gsk_...               # dashboard.groq.com
TOGETHER_API_KEY=...               # api.together.xyz (fallback images)
OPENAI_API_KEY=sk-...              # platform.openai.com (génération images principale)
HF_TOKEN=hf_...                    # huggingface.co/settings/tokens (fallback images)

# ── SUPABASE ─────────────────────────────────────────────
# Récupérer dans : Supabase > Project Settings > API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # SERVICE ROLE (ne jamais exposer côté client)
# (SUPABASE_JWT_SECRET optionnel pour vérification locale des tokens)

# ── STRIPE ───────────────────────────────────────────────
# Récupérer dans : dashboard.stripe.com
STRIPE_SECRET_KEY=sk_live_...      # (ou sk_test_ en dev)
STRIPE_WEBHOOK_SECRET=whsec_...    # Stripe CLI : stripe listen --forward-to localhost:3000/api/stripe-webhook
# Price IDs — créer les produits sur dashboard.stripe.com/products
STRIPE_PRICE_IDS={"pro_mensuel":"price_xxx","pro_annuel":"price_xxx","studio_mensuel":"price_xxx","studio_annuel":"price_xxx"}

# ── YOUTUBE ──────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → YouTube Data API v3 → Credentials
YOUTUBE_API_KEY=AIza...               # Clé API simple (données publiques, fetch chaîne auto) ← PRIORITÉ
YOUTUBE_CLIENT_ID=xxx.apps.googleusercontent.com  # OAuth (optionnel, pour données privées)

# ── EMAIL (Brevo) ─────────────────────────────────────────
BREVO_API_KEY=xkeysib-...          # app.brevo.com/settings/keys/api

# ── APP ──────────────────────────────────────────────────
APP_URL=https://creatis.app        # Ton domaine Vercel
NODE_ENV=production

{
  "version": 2,
  "name": "creatis",
  "buildCommand": null,
  "outputDirectory": ".",
  "crons": [
    {
      "path": "/api/user-sync?action=email_cron",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/prospect-batch",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/prospect-batch?type=clipper",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/tweet-daily",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/tweet-daily",
      "schedule": "1 7 19 5 *"
    },
    {
      "path": "/api/tweet-daily",
      "schedule": "0 16 19 5 *"
    }
  ],
  "functions": {
    "api/stripe-webhook.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/prospect-batch.js": {
      "memory": 1024,
      "maxDuration": 300
    },
    "api/repurpose.js": {
      "memory": 1024,
      "maxDuration": 300
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/app", "dest": "/app.html" },
    { "src": "/js/app-r8.js", "dest": "/js/app.js" },
    { "src": "/js/app-r9.js", "dest": "/js/app.js" },
    { "src": "/js/app-r10.js", "dest": "/js/app.js" },
    { "src": "/js/app-r11.js", "dest": "/js/app.js" },
    { "src": "/js/app-r12.js", "dest": "/js/app.js" },
    { "src": "/js/app-r13.js", "dest": "/js/app.js" },
    { "src": "/js/app-r14.js", "dest": "/js/app.js" },
    { "src": "/js/app-r15.js", "dest": "/js/app.js" },
    { "src": "/js/app-r16.js", "dest": "/js/app.js" },
    { "src": "/js/app-r17.js", "dest": "/js/app.js" },
    { "src": "/js/app-r18.js", "dest": "/js/app.js" },
    { "src": "/js/app-r19.js", "dest": "/js/app.js" },
    { "src": "/js/app-r20.js", "dest": "/js/app.js" },
    { "src": "/js/app-r21.js", "dest": "/js/app.js" },
    { "src": "/js/app-r22.js", "dest": "/js/app.js" },
    { "src": "/js/app-r23.js", "dest": "/js/app.js" },
    { "src": "/css/app-r4.css", "dest": "/css/app.css" },
    { "src": "/auth", "dest": "/auth.html" },
    { "src": "/auth/callback", "dest": "/auth/callback.html" },
    { "src": "/success", "dest": "/success.html" },
    { "src": "/cancel", "dest": "/cancel.html" },
    { "src": "/cgu", "dest": "/cgu.html" },
    { "src": "/mentions-legales", "dest": "/mentions-legales.html" },
    { "src": "/confidentialite", "dest": "/confidentialite.html" },
    { "src": "/affiliation", "dest": "/affiliation.html" },
    { "src": "/parrainage", "dest": "/parrainage.html" },
    { "src": "/test-chat", "dest": "/test-chat.html" },
    { "src": "/lp", "dest": "/lp.html" },
    { "src": "/outils", "dest": "/outils.html" },
    { "src": "/generateur-clips-viraux", "dest": "/generateur-clips-viraux.html" },
    { "src": "/clips-v2", "dest": "/clips-v2.html" },
    { "src": "/studio", "dest": "/clips-v2.html" },
    { "src": "/outil-ia-createurs-contenu", "dest": "/outil-ia-createurs-contenu.html" },
    { "src": "/programme-affiliation-youtuber", "dest": "/programme-affiliation-youtuber.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, s-maxage=0" },
        { "key": "Surrogate-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, s-maxage=0" },
        { "key": "Surrogate-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, s-maxage=0" },
        { "key": "Surrogate-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/app",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, s-maxage=0" },
        { "key": "Surrogate-Control", "value": "no-store" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" }
      ]
    }
  ]
}
